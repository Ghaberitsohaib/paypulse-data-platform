# ==============================================================================
# PayPulse — FinTech & Payment Lakehouse Environment Configuration
# ==============================================================================

# Project & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (Core Banking OLTP & Metadata)
POSTGRES_USER=paypulse_admin
POSTGRES_PASSWORD=paypulse_secure_pass
POSTGRES_DB=paypulse_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Apache Kafka (KRaft Mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PAYMENTS_TOPIC=fintech.payments.transactions
KAFKA_AML_ALERTS_TOPIC=fintech.aml.fraud_alerts
KAFKA_CONSUMER_GROUP=paypulse-lakehouse-sink

# MinIO (S3 Compatible Data Lake)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=paypulse-lakehouse

# Google Cloud Platform (Terraform & BigQuery)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
BIGQUERY_DATASET_RAW=fintech_raw
BIGQUERY_DATASET_ANALYTICS=fintech_analytics

# Exchange Rates & KYC API
FX_BASE_CURRENCY=USD
ENABLE_MOCK_BANK_API=true
